#!/usr/bin/env sh
# Check staged files with the same formatter and content lint used in CI.
set -eu

if [ "${HUSKY:-}" = "0" ] || [ "${CI:-}" = "true" ] || [ "${GITHUB_ACTIONS:-}" = "true" ]; then
  echo "pre-commit: skipped (HUSKY=0 or CI)"
  exit 0
fi

# Run overlapping tasks in order: formatting must finish before MDX lint and type checking.
pnpm exec lint-staged --concurrent false
