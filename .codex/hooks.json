{
  "description": "Repo-local Codex hooks for arbitrum-docs. Scripts live in .codex/hooks/ and read the hook JSON on stdin.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/guard-generated-content.sh\"",
            "statusMessage": "Checking for generated content"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/require-pattern-guide.sh\"",
            "statusMessage": "Checking the style guide was read"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.tool_input.command) - \\(.tool_input.description // \"No description\")\"' >> ~/.claude/bash-command-log.txt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/format-changed.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting changed files"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/optimize-svg.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/run-colocated-tests.sh\"",
            "timeout": 120,
            "statusMessage": "Running colocated tests"
          }
        ]
      }
    ]
  }
}
