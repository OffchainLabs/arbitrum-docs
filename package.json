{
  "name": "Fumadocs-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "prettier --check . && node scripts/check-links.ts && next build",
    "dev": "pnpm install && pnpm clean && next dev",
    "start": "next start",
    "check-links": "node scripts/check-links.ts",
    "clean": "node scripts/clean.ts",
    "contracts:check": "node scripts/generate-contract-addresses.ts --check",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "references:check": "node scripts/references-check.ts",
    "test": "node --test \"scripts/**/*.test.ts\" \"eslint/**/*.test.ts\"",
    "test:browser": "node --test \"tests/browser/*.test.ts\"",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "vars:check": "node scripts/vars-check.ts",
    "cli:check": "node scripts/generate-cli-reference.ts --check",
    "cli:generate": "node scripts/generate-cli-reference.ts",
    "contracts:generate": "node scripts/generate-contract-addresses.ts",
    "edge-challenge:fetch": "node scripts/fetch-edge-challenge-data.ts",
    "faq:check": "node scripts/generate-faq.ts --check",
    "faq:fetch": "node scripts/faq-fetch.ts",
    "faq:generate": "node scripts/generate-faq.ts",
    "format": "prettier --write .",
    "move-doc": "node scripts/move-doc.ts",
    "nitro:check-release": "node scripts/check-nitro-release.ts",
    "precompiles:check": "node scripts/generate-precompile-tables.ts --check",
    "precompiles:generate": "node scripts/generate-precompile-tables.ts",
    "stylus:check": "node scripts/generate-stylus-examples.ts --check",
    "stylus:generate": "node scripts/generate-stylus-examples.ts",
    "postinstall": "fumadocs-mdx"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@ai-sdk/react": "4.0.147",
    "@base-ui/react": "1.9.0",
    "@ethersproject/address": "5.8.0",
    "@floating-ui/react": "0.27.20",
    "@fuma-translate/react": "1.0.2",
    "@inkeep/cxkit-react": "0.5.119",
    "@radix-ui/react-dialog": "1.3.1",
    "ai": "7.0.143",
    "class-variance-authority": "0.7.1",
    "d3-hierarchy": "3.1.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "0.19.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "posthog-js": "1.438.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-rehype": "11.1.2",
    "remend": "1.4.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "5.1.0",
    "viem": "2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arbitrum/sdk": "4.1.0",
    "@babel/parser": "8.0.7",
    "@babel/types": "8.0.6",
    "@eslint/core": "1.2.1",
    "@eslint/plugin-kit": "0.7.3",
    "@mdx-js/mdx": "3.1.1",
    "@notionhq/client": "5.27.1",
    "@offchainlabs/prettier-config": "0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/d3-zoom": "3.0.9",
    "@types/estree": "1.0.9",
    "@types/estree-jsx": "1.0.5",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "3.0.3",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-extension-mdxjs": "3.0.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vfile": "6.0.3"
  }
}
