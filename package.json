{
  "name": "Fumadocs-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/check-links.ts && next build",
    "dev": "next dev",
    "start": "next start",
    "check-links": "node scripts/check-links.ts",
    "content:lint": "node scripts/content-lint.ts",
    "contracts:check": "node scripts/generate-contract-addresses.ts --check",
    "format:check": "prettier --check .",
    "references:check": "node scripts/references-check.ts",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "test:browser": "node --test \"tests/browser/*.test.ts\"",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "vars:check": "node scripts/vars-check.ts",
    "cli:check": "node scripts/generate-cli-reference.ts --check",
    "cli:generate": "node scripts/generate-cli-reference.ts",
    "contracts:generate": "node scripts/generate-contract-addresses.ts",
    "edge-challenge:fetch": "node scripts/fetch-edge-challenge-data.ts",
    "faq:check": "node scripts/generate-faq.ts --check",
    "faq:fetch": "node scripts/faq-fetch.ts",
    "faq:generate": "node scripts/generate-faq.ts",
    "format": "prettier --write .",
    "move-doc": "node scripts/move-doc.ts",
    "nitro:check-release": "node scripts/check-nitro-release.ts",
    "precompiles:check": "node scripts/generate-precompile-tables.ts --check",
    "precompiles:generate": "node scripts/generate-precompile-tables.ts",
    "stylus:check": "node scripts/generate-stylus-examples.ts --check",
    "stylus:generate": "node scripts/generate-stylus-examples.ts",
    "postinstall": "fumadocs-mdx"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@ethersproject/address": "5.8.0",
    "@floating-ui/react": "0.27.20",
    "@inkeep/cxkit-react": "0.5.119",
    "@radix-ui/react-dialog": "1.1.23",
    "class-variance-authority": "0.7.1",
    "d3-hierarchy": "3.1.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.13",
    "katex": "0.18.4",
    "lucide-react": "1.47.0",
    "next": "16.3.4",
    "posthog-js": "1.430.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "^3.6.0",
    "viem": "2.56.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arbitrum/sdk": "4.1.0",
    "@mdx-js/mdx": "3.1.1",
    "@notionhq/client": "5.27.0",
    "@offchainlabs/prettier-config": "0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.2.0",
    "@types/d3-zoom": "3.0.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "1.58.2",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3"
  }
}
