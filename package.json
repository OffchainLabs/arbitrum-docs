{
  "name": "Fumadocs-test",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/versioned-docs-check.mjs && node scripts/check-links.mjs && next build --experimental-build-mode=compile",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "inventory-links": "node scripts/inventory-links.mjs",
    "move-doc": "node scripts/move-doc.mjs",
    "check-links": "node scripts/check-links.mjs",
    "nav:check": "node scripts/nav-check.mjs",
    "drift": "node scripts/upstream-drift.mjs",
    "prose:diff": "node scripts/prose-diff.mjs",
    "pr:gap": "node scripts/upstream-pr-gap.mjs",
    "tree:map": "node scripts/tree-map-report.mjs",
    "reconstruct": "node scripts/reconstruct-history.mjs",
    "pr:replay": "node scripts/replay-prs.mjs",
    "restructure": "node scripts/restructure.mjs",
    "partials:migrate": "node scripts/migrate-partials.mjs",
    "partials:catalog": "node scripts/generate-partials-catalog.mjs",
    "partials:check": "node scripts/partials-check.mjs",
    "glossary:migrate": "node scripts/migrate-glossary.mjs",
    "quicklooks:migrate": "node scripts/migrate-quicklooks.mjs",
    "nitro:check-release": "node scripts/check-nitro-release.mjs",
    "nitro:image-check": "node scripts/pinned-image-check.mjs",
    "precompiles:generate": "node scripts/generate-precompile-tables.mjs",
    "precompiles:check": "node scripts/generate-precompile-tables.mjs --check",
    "references:check": "node scripts/references-check.mjs",
    "redirects:legacy": "node scripts/generate-legacy-redirects.mjs",
    "redirects:current": "node scripts/generate-current-redirects.mjs",
    "redirects:check": "node scripts/redirects-check.mjs",
    "vars:check": "node scripts/vars-check.mjs",
    "content:lint": "node scripts/content-lint.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@ethersproject/address": "5.8.0",
    "@floating-ui/react": "0.27.20",
    "@inkeep/cxkit-react": "0.5.119",
    "@radix-ui/react-dialog": "1.1.23",
    "class-variance-authority": "0.7.1",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-twoslash": "3.3.0",
    "fumadocs-ui": "16.15.12",
    "katex": "0.18.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@offchainlabs/prettier-config": "0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vfile": "6.0.3"
  }
}
